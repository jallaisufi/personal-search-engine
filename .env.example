# Copy to .env and adjust:  cp .env.example .env
# .env is gitignored — real keys never go into the repo.

# ── Run mode ─────────────────────────────────────────────────────────────
# "local-ai" starts Ollama in Docker and pulls the models on first start.
# Remove it (COMPOSE_PROFILES=) if you only use API-key providers below.
COMPOSE_PROFILES=local-ai

# ── Documents ────────────────────────────────────────────────────────────
# Folder on your machine to index (mounted read-only into the worker).
LOCAL_DOCS_PATH=./sample-docs
SYNC_INTERVAL_SECONDS=60

# ── AI providers ─────────────────────────────────────────────────────────
# Embeddings power search; the LLM powers Ask mode and deadlines (later weekends).
# ollama (default, free, local) | openai | fake (tests/CI only)
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768
OLLAMA_URL=http://ollama:11434

# Optional — billed to your own account. Changing the embedding provider or
# model requires a re-index, because vectors from different models don't mix.
# For OpenAI embeddings set EMBEDDING_PROVIDER=openai, EMBEDDING_MODEL=text-embedding-3-small
# (EMBEDDING_DIM can stay 768) and:
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Ask mode: the model that writes answers. Default is a small local model (~2 GB).
# Bigger local models answer better but need more RAM, e.g. LLM_MODEL=llama3.1:8b (~5 GB).
# With a key: LLM_PROVIDER=openai + LLM_MODEL=gpt-4o-mini, or
#             LLM_PROVIDER=anthropic + LLM_MODEL=claude-haiku-5-5
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2:3b
ASK_SOURCES=6

# ── Chunking ─────────────────────────────────────────────────────────────
CHUNK_TOKENS=500
CHUNK_OVERLAP_TOKENS=50

# ── Caching ──────────────────────────────────────────────────────────────
# How long a search result stays cached. New or changed documents invalidate
# all cached results immediately, so this only bounds memory use.
SEARCH_CACHE_TTL_SECONDS=600

# ── Database (defaults match compose.yaml) ───────────────────────────────
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=search
